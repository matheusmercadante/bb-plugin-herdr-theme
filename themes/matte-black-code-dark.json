{
  "name": "Matte Black",
  "type": "dark",
  "colors": {
    "editor.background": "#121212",
    "editor.foreground": "#eaeaea",
    "editorLineNumber.foreground": "#333333",
    "editor.lineHighlightBackground": "#212121",
    "editor.selectionBackground": "#F59E0B80"
  },
  "tokenColors": [
    {
      "name": "variable",
      "scope": [
        "variable",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#d97706"
      }
    },
    {
      "name": "variable.parameter",
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#bebebe"
      }
    },
    {
      "name": "variable.builtin",
      "scope": [
        "variable.language"
      ],
      "settings": {
        "foreground": "#3b82f6"
      }
    },
    {
      "name": "property",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.variable.property",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#f59e0b"
      }
    },
    {
      "name": "constant",
      "scope": [
        "constant",
        "support.constant",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#d97706"
      }
    },
    {
      "name": "number",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#efbf04"
      }
    },
    {
      "name": "boolean",
      "scope": [
        "constant.language.boolean"
      ],
      "settings": {
        "foreground": "#10b981"
      }
    },
    {
      "name": "string",
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#eaeaea"
      }
    },
    {
      "name": "string.escape",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#efbf04"
      }
    },
    {
      "name": "string.regexp",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#d97706"
      }
    },
    {
      "name": "string.special.url",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#f59e0b",
        "fontStyle": "italic"
      }
    },
    {
      "name": "keyword",
      "scope": [
        "keyword",
        "keyword.control",
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#059669"
      }
    },
    {
      "name": "operator",
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#bebebe"
      }
    },
    {
      "name": "keyword.operator",
      "scope": [
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.logical.python"
      ],
      "settings": {
        "foreground": "#059669"
      }
    },
    {
      "name": "keyword.directive",
      "scope": [
        "keyword.control.directive",
        "meta.preprocessor"
      ],
      "settings": {
        "foreground": "#3b82f6"
      }
    },
    {
      "name": "keyword.export",
      "scope": [
        "keyword.control.export"
      ],
      "settings": {
        "foreground": "#f59e0b"
      }
    },
    {
      "name": "function",
      "scope": [
        "entity.name.function"
      ],
      "settings": {
        "foreground": "#dc2626"
      }
    },
    {
      "name": "function.call",
      "scope": [
        "meta.function-call entity.name.function",
        "meta.function-call.generic",
        "support.function"
      ],
      "settings": {
        "foreground": "#f59e0b"
      }
    },
    {
      "name": "function.method",
      "scope": [
        "entity.name.function.member",
        "meta.method-call entity.name.function"
      ],
      "settings": {
        "foreground": "#f59e0b"
      }
    },
    {
      "name": "function.builtin",
      "scope": [
        "support.function.builtin"
      ],
      "settings": {
        "foreground": "#d97706"
      }
    },
    {
      "name": "function.decorator",
      "scope": [
        "meta.decorator",
        "entity.name.function.decorator"
      ],
      "settings": {
        "foreground": "#d97706"
      }
    },
    {
      "name": "type",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#fbbf24"
      }
    },
    {
      "name": "type.builtin",
      "scope": [
        "support.type.primitive",
        "support.type.builtin"
      ],
      "settings": {
        "foreground": "#f59e0b",
        "fontStyle": "italic"
      }
    },
    {
      "name": "constructor",
      "scope": [
        "entity.name.function.constructor",
        "new.expr entity.name.type"
      ],
      "settings": {
        "foreground": "#fbbf24"
      }
    },
    {
      "name": "namespace",
      "scope": [
        "entity.name.namespace",
        "entity.name.module"
      ],
      "settings": {
        "foreground": "#fbbf24",
        "fontStyle": "italic"
      }
    },
    {
      "name": "punctuation",
      "scope": [
        "punctuation",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#8a8a8d"
      }
    },
    {
      "name": "tag",
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#059669"
      }
    },
    {
      "name": "tag.attribute",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#d97706",
        "fontStyle": "italic"
      }
    },
    {
      "name": "comment",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#8a8a8d",
        "fontStyle": "italic"
      }
    },
    {
      "name": "title",
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#d97706",
        "fontStyle": "bold"
      }
    },
    {
      "name": "emphasis.strong",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#fbbf24",
        "fontStyle": "bold"
      }
    },
    {
      "name": "emphasis",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#bebebe",
        "fontStyle": "italic"
      }
    },
    {
      "name": "text.literal",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code"
      ],
      "settings": {
        "foreground": "#fbbf24"
      }
    },
    {
      "name": "link_text",
      "scope": [
        "string.other.link"
      ],
      "settings": {
        "foreground": "#059669",
        "fontStyle": "bold"
      }
    },
    {
      "name": "punctuation.list_marker",
      "scope": [
        "punctuation.definition.list.begin.markdown"
      ],
      "settings": {
        "foreground": "#efbf04",
        "fontStyle": "bold"
      }
    },
    {
      "name": "diff.plus",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#10b981"
      }
    },
    {
      "name": "diff.minus",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#dc2626"
      }
    }
  ]
}
